// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  avatarUrl     String?
  credits       Int       @default(30)
  creditsUsed   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastStudyAt   DateTime?
  streak        Int       @default(0)
  ownApiKey     String?   // Chave de IA própria do usuário
  ownApiProvider String?  // Provedor da chave própria

  answers       Answer[]
  studyPlans    StudyPlan[]
  sessions      Session[]
  creditLogs    CreditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Question {
  id           String       @id @default(cuid())
  banca        String
  area         String
  subtopic     String?
  cargo        String?
  education    String?
  difficulty   String
  type         QuestionType @default(MULTIPLE_CHOICE)
  format       String
  enunciado    String
  options      Json
  correctIndex Int
  comentario   String
  isOriginal   Boolean      @default(false)
  fromEdital   Boolean      @default(false)
  aiProvider   String       @default("claude")
  aiModel      String?
  promptHash   String?      // Para cache
  createdAt    DateTime     @default(now())

  answers Answer[]

  @@index([promptHash])
  @@map("questions")
}

model Answer {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  selectedIdx  Int
  isCorrect    Boolean
  timeSpentMs  Int?
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model StudyPlan {
  id            String    @id @default(cuid())
  userId        String
  title         String
  banca         String?
  cargo         String?
  examDate      DateTime?
  hoursPerDay   String
  level         String
  editalText    String?
  planJson      Json
  flashcards    Json
  daysCompleted Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_plans")
}

// ── CACHE DE IA ──────────────────────────────
model AICache {
  id         String   @id @default(cuid())
  promptHash String   @unique
  prompt     String
  response   String
  provider   String
  model      String?
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([promptHash])
  @@index([expiresAt])
  @@map("ai_cache")
}

// ── CRÉDITOS ─────────────────────────────────
model CreditLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positivo = ganhou, negativo = gastou
  action    String   // "generate_question", "generate_plan", "purchase", etc
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_logs")
}

// ── RATE LIMIT ───────────────────────────────
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // ip:action ou userId:action
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([resetAt])
  @@map("rate_limits")
}

// ── CONFIG ADMIN ─────────────────────────────
model AdminConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("admin_config")
}

model ApiKey {
  id         String    @id @default(cuid())
  provider   String    @unique
  keyHash    String
  model      String
  isEnabled  Boolean   @default(true)
  lastTested DateTime?
  testStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("api_keys")
}
